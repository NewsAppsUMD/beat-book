{
  "name": "Beat Book Builder",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "postCreateCommand": "make install && curl -fsSL https://ollama.com/install.sh | sh && (ollama serve > /tmp/ollama.log 2>&1 &) && sleep 3 && ollama pull qwen3-embedding:0.6b",
  "postStartCommand": "pgrep -x ollama > /dev/null || (ollama serve > /tmp/ollama.log 2>&1 &)",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Beat Book",
      "onAutoForward": "openBrowser"
    }
  },
  "containerEnv": {
    "HOST": "0.0.0.0"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
