{
  "name": "Beat Book Builder",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  // Installs Python packages (with uv) and Ollama at the same time.
  "postCreateCommand": "sh .devcontainer/setup.sh",
  "postStartCommand": "command -v ollama > /dev/null && (pgrep -x ollama > /dev/null || (nohup ollama serve > /tmp/ollama.log 2>&1 &)) || true",
  "postAttachCommand": {
    "terminal": "echo 'Codespace ready. See docs/student-guide.md — next: cp .env.example .env, fill in your keys, then make run.'"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Beat Book",
      "onAutoForward": "openBrowser"
    }
  },
  "containerEnv": {
    "HOST": "0.0.0.0",
    // Set to "false" for a class using Option A (Anthropic + OpenAI), which
    // never uses Ollama; it skips the Ollama install and model download.
    "INSTALL_OLLAMA": "true"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
