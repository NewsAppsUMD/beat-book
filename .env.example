# Copy this file to .env and fill in real values.
# Used by app.py at startup (see the loader near the top of that file).
#
# IMPORTANT: paste keys with no quotes and no surrounding spaces
# (ANTHROPIC_API_KEY=sk-ant-..., not ANTHROPIC_API_KEY="sk-ant-...").
# The .env loader does not strip quotes.
#
# This class offers TWO setups — pick ONE (see docs/student-guide.md):
#   Option A: Anthropic + OpenAI   — fully hosted, simplest, no local setup.
#   Option B: Anthropic + Ollama   — Ollama Cloud for chat, a local Ollama
#             model (already installed on your Codespace) for embeddings.
# Uncomment the block for your assigned option below and leave the other
# commented out. Anthropic is required either way.

# Anthropic — used for scanned-PDF OCR and the live-web research agent in
# both options; also used for story normalization, cluster labeling, and the
# beat-book writing agent in Option A (CHAT_PROVIDER=anthropic, the default).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Option A: Anthropic + OpenAI (fully hosted) ─────────────────────────────

# OpenAI — used only for embeddings (topic clustering, citation matching).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Option B: Anthropic + Ollama (Ollama Cloud chat, local embeddings) ──────
# Uncomment this whole block, and comment out OPENAI_API_KEY above instead.

# Chat provider for story normalization, cluster labeling, and the beat-book
# writing agent: "anthropic" (default) or "ollama".
# CHAT_PROVIDER=ollama

# Ollama chat settings (used when CHAT_PROVIDER=ollama). These are SEPARATE
# from the embedding Ollama settings below, since chat runs on Ollama Cloud
# while embeddings run on a local Ollama instance inside the Codespace.
# OLLAMA_CHAT_HOST=https://ollama.com
# OLLAMA_CHAT_MODEL=qwen3.5:397b-cloud
# OLLAMA_API_KEY=your-ollama-key-here

# Embeddings — used for topic clustering and citation matching. Runs
# locally, no key needed: your Codespace installs Ollama and pulls this
# model automatically (see .devcontainer/devcontainer.json), regardless of
# which option you end up using.
# EMBED_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# ── Optional (either option) ────────────────────────────────────────────────

# Enable extended/reasoning mode on the final beat-book write. Higher
# quality but materially slower. Default: off. Set to true/1/yes/on to
# enable. Not recommended for class use.
# ENABLE_THINKING=true

# Firecrawl — OPTIONAL. When set, PDFs and pasted URLs are parsed/scraped via
# Firecrawl (native + scanned PDFs and JS-rendered pages handled uniformly).
# Without it, PDFs fall back to local PyMuPDF + Haiku-vision OCR and URLs fall
# back to an SSRF-protected httpx fetch — so a Firecrawl account is not required.
# Get one at https://firecrawl.dev
# FIRECRAWL_API_KEY=fc-...
