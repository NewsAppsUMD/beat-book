# Copy this file to .env and fill in real values.
# Loaded at startup by env_settings.py.
#
# IMPORTANT: paste keys with no quotes and no surrounding spaces
# (ANTHROPIC_API_KEY=sk-ant-..., not ANTHROPIC_API_KEY="sk-ant-...").
# The .env loader does not strip quotes.
#
# A variable exported in your shell overrides the same one here. The startup
# log names the models in use and warns about each override; run
# `unset NAME` before `make run` to use this file's value.
#
# Pick ONE setup (see docs/student-guide.md for the class options):
#   Option A: Anthropic + OpenAI   — fully hosted, simplest, no local setup.
#   Option B: Anthropic + Ollama   — Ollama Cloud for chat, a local Ollama
#             model (already installed on your Codespace) for embeddings.
#   Option C: fully local          — Ollama on this machine for everything;
#             no API keys. Turn off Web research on the topic screen.
# Uncomment the block for your option and leave the others commented out.
# Options A and B need an Anthropic key; Option C needs none.

# Anthropic — used for the beat-book writing agent, story normalization and
# topic labels in Option A (CHAT_PROVIDER=anthropic, the default); for web
# research on Claude Sonnet in Options A and B; and for OCR of scanned PDFs.
# Not needed when an Ollama model writes and research is off or on Ollama.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Option A: Anthropic + OpenAI (fully hosted) ─────────────────────────────

# OpenAI — used only for embeddings (topic clustering, citation matching).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ── Option B: Anthropic + Ollama (Ollama Cloud chat, local embeddings) ──────
# Uncomment this whole block, and comment out OPENAI_API_KEY above instead.

# Chat provider for story normalization, cluster labeling, and the beat-book
# writing agent: "anthropic" (default) or "ollama".
# CHAT_PROVIDER=ollama

# Ollama chat settings (used when CHAT_PROVIDER=ollama). These are SEPARATE
# from the embedding Ollama settings below, since chat runs on Ollama Cloud
# while embeddings run on a local Ollama instance inside the Codespace.
# OLLAMA_CHAT_HOST=https://ollama.com
# OLLAMA_CHAT_MODEL=qwen3.5:397b-cloud
# OLLAMA_API_KEY=your-ollama-key-here

# Embeddings — used for topic clustering and citation matching. Runs
# locally, no key needed: your Codespace installs Ollama and pulls this
# model automatically (see .devcontainer/devcontainer.json), regardless of
# which option you end up using.
# EMBED_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# Only if embeddings run on Ollama Cloud instead (OLLAMA_HOST=https://ollama.com):
# OLLAMA_EMBED_API_KEY=your-ollama-key-here

# ── Option C: fully local (Ollama on this machine, no keys) ─────────────────
# Comment out ANTHROPIC_API_KEY and OPENAI_API_KEY above, uncomment this
# block, and turn off Web research on the topic screen. Every step runs on
# this machine except OCR of scanned PDFs. qwen3.6:35b-mlx is a 22 GB model;
# a 2,000-word book took under two minutes of writing on an M3 Max.
# CHAT_PROVIDER=ollama
# OLLAMA_CHAT_HOST=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen3.6:35b-mlx
# EMBED_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# ── Optional (any option) ───────────────────────────────────────────────────

# Enable extended/reasoning mode on the final beat-book write. Higher
# quality but materially slower. Default: off. Set to true/1/yes/on to
# enable. Not recommended for class use.
# ENABLE_THINKING=true

# Embeddings are cached on disk in .cache/embeddings/, so rebuilding from the
# same stories skips most embedding. Set to off to always embed fresh.
# EMBED_CACHE=off

# Firecrawl — OPTIONAL. When set, PDFs and pasted URLs are parsed/scraped via
# Firecrawl (native + scanned PDFs and JS-rendered pages handled uniformly).
# Without it, PDFs fall back to local PyMuPDF + Haiku-vision OCR and URLs fall
# back to an SSRF-protected httpx fetch — so a Firecrawl account is not required.
# Get one at https://firecrawl.dev
# FIRECRAWL_API_KEY=fc-...

# ── Web research on Ollama (optional) ───────────────────────────────────────
# Web research runs on Anthropic (Claude Sonnet 4.6) unless this is set to
# ollama. On Ollama the model is RESEARCH_OLLAMA_MODEL, or OLLAMA_CHAT_MODEL
# if unset, and it runs at RESEARCH_OLLAMA_HOST, or OLLAMA_CHAT_HOST if unset:
# for example a model on this machine while writing runs on Ollama's cloud.
# Ollama models quote by pointing at a page's numbered sentences; the app
# copies them, and the same checks apply to every fact. No Ollama model has
# matched Claude yet: Qwen 3.6 added 1 fact in its first evaluation run.
# RESEARCH_PROVIDER=ollama
# RESEARCH_OLLAMA_MODEL=qwen3.6:35b-mlx
# RESEARCH_OLLAMA_HOST=http://localhost:11434

# Ollama models can't search on their own, so the app calls Ollama's search
# service for them. It uses OLLAMA_API_KEY unless this is set; without a key,
# research runs without search.
# OLLAMA_SEARCH_API_KEY=your-ollama-key-here
# OLLAMA_SEARCH_HOST=https://ollama.com

# Some Ollama models (GLM-5.3) ignore "think": false and write their reasoning
# into the answer, which breaks topic labels, structured replies and research
# turns. OLLAMA_THINK=on asks Ollama for thinking mode on every call, so the
# reasoning arrives in a separate field the app discards. Models without
# thinking support are detected and called without it. Recommended for GLM;
# leave it OFF for Qwen and Gemma, which then think until short calls run out
# of room and return nothing.
# OLLAMA_THINK=on
