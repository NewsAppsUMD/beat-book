# Copy this file to .env and fill in real values.
# Used by app.py at startup (see the loader near the top of that file).
#
# IMPORTANT: paste keys with no quotes and no surrounding spaces
# (ANTHROPIC_API_KEY=sk-ant-..., not ANTHROPIC_API_KEY="sk-ant-...").
# The .env loader does not strip quotes.

# ── Required for class use (hosted Anthropic + OpenAI, default providers) ──

# Anthropic — used for story normalization, cluster labeling, the beat-book
# writing agent, the research agent, and scanned-PDF OCR.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — used only for embeddings (topic clustering, citation matching).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Optional ─────────────────────────────────────────────────────────────

# Enable extended/reasoning mode on the final beat-book write. Higher
# quality but materially slower. Default: off. Set to true/1/yes/on to
# enable. Not recommended for class use.
# ENABLE_THINKING=true

# ── Not needed for class use — local/private inference via Ollama ─────────
# (CHAT_PROVIDER and EMBED_PROVIDER default to "anthropic" and "openai",
# which is what the class uses. Leave everything below commented out.)

# EMBED_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
# OLLAMA_EMBED_API_KEY=your-key-here  # only needed if OLLAMA_HOST points at Ollama cloud

# CHAT_PROVIDER=ollama
# OLLAMA_CHAT_HOST=https://ollama.com
# OLLAMA_CHAT_MODEL=qwen3:8b
# OLLAMA_API_KEY=your-key-here
