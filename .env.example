# Copy this file to .env and fill in real values.
# Used by app.py at startup (see the loader near the top of that file).

# Embedding provider: "openai" (default) or "ollama".
# EMBED_PROVIDER=openai

# OpenAI — used only for embeddings when EMBED_PROVIDER=openai.
# Not required when using Ollama.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Ollama — used when EMBED_PROVIDER=ollama.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
# OLLAMA_EMBED_API_KEY=your-key-here  # only needed if OLLAMA_HOST points at Ollama cloud

# Anthropic — used for OCR, the research agent, and
# (when CHAT_PROVIDER=anthropic) ingest normalization, cluster labeling,
# and the beat-book agent. Not required when CHAT_PROVIDER=ollama
# (unless you need OCR or the research agent).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Chat provider for the beat-book agent and cluster labeling:
# "anthropic" (default) or "ollama".
# CHAT_PROVIDER=anthropic

# Ollama chat settings (only used when CHAT_PROVIDER=ollama).
# These are SEPARATE from the embedding Ollama settings (OLLAMA_HOST /
# OLLAMA_EMBED_MODEL), since embeddings typically run on a local Ollama
# while chat may use Ollama cloud.
# OLLAMA_CHAT_HOST=https://ollama.com
# OLLAMA_CHAT_MODEL=qwen3:8b
# OLLAMA_API_KEY=your-key-here

# Optional — enable extended/reasoning mode on the final beat-book write.
# Applies to both providers (Anthropic's extended thinking, Ollama's `think`
# field). Higher quality but materially slower. Default: off. Set to
# true/1/yes/on to enable. Note: thinking is incompatible with forced
# tool_choice, so the ingest normalization step ignores this flag.
# ENABLE_THINKING=true
