# Copy this file to .env and fill in real values.
# Used by app.py at startup (see the loader near the top of that file).
#
# IMPORTANT: paste keys with no quotes and no surrounding spaces
# (ANTHROPIC_API_KEY=sk-ant-..., not ANTHROPIC_API_KEY="sk-ant-...").
# The .env loader does not strip quotes.

# ── Required for class use (Anthropic + Ollama Cloud chat, local embeddings) ──

# Anthropic — used for scanned-PDF OCR and the live-web research agent.
# Story normalization, cluster labeling, and the beat-book writing agent run
# on Ollama Cloud instead (see CHAT_PROVIDER below), but Anthropic is still
# required for these two steps regardless of CHAT_PROVIDER.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Chat provider for story normalization, cluster labeling, and the beat-book
# writing agent: "anthropic" (default) or "ollama". The class uses "ollama".
CHAT_PROVIDER=ollama

# Ollama chat settings (used when CHAT_PROVIDER=ollama). These are SEPARATE
# from the embedding Ollama settings below, since chat runs on Ollama Cloud
# while embeddings run on a local Ollama instance inside the Codespace.
OLLAMA_CHAT_HOST=https://ollama.com
OLLAMA_CHAT_MODEL=qwen3.5:397b-cloud
OLLAMA_API_KEY=your-ollama-key-here

# Embeddings — used for topic clustering and citation matching. The class
# runs this locally, no key needed: your Codespace installs Ollama and pulls
# this model automatically (see .devcontainer/devcontainer.json).
EMBED_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# ── Optional ─────────────────────────────────────────────────────────────

# Enable extended/reasoning mode on the final beat-book write. Higher
# quality but materially slower. Default: off. Set to true/1/yes/on to
# enable. Not recommended for class use.
# ENABLE_THINKING=true

# Firecrawl — OPTIONAL. When set, PDFs and pasted URLs are parsed/scraped via
# Firecrawl (native + scanned PDFs and JS-rendered pages handled uniformly).
# Without it, PDFs fall back to local PyMuPDF + Haiku-vision OCR and URLs fall
# back to an SSRF-protected httpx fetch — so a Firecrawl account is not required.
# Get one at https://firecrawl.dev
# FIRECRAWL_API_KEY=fc-...

# ── Not needed for this class — hosted OpenAI embeddings instead of local ──
# (Only relevant outside the class's Ollama-equipped Codespace setup, e.g.
# running locally without Ollama installed. Leave commented out for class
# use — EMBED_PROVIDER=ollama above already covers it. Setting this also
# requires EMBED_PROVIDER=openai, replacing the block above.)

# OPENAI_API_KEY=sk-...
